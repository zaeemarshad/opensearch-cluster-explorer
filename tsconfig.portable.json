{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "common/**/*.ts",
    "server/service.ts",
    "server/normalise.ts",
    "public/components/**/*.tsx",
    "public/client.ts",
    "tests/**/*.ts"
  ]
}
